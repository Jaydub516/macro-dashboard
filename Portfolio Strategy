        function renderMarkdown(md) {
            if (!md) return '';
            let html = md
                .replace(/^### (.*$)/gim, '<h3>$1</h3>')
                .replace(/^## (.*$)/gim, '<h2>$1</h2>')
                .replace(/^# (.*$)/gim, '<h1>$1</h1>')
                .replace(/^\> (.*$)/gim, '<blockquote>$1</blockquote>')
                .replace(/\*\*(.*Card|\*\*.*?)\*\*/gim, '<strong>$1</strong>')
                .replace(/\*\*(.*?)\*\*/gim, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/gim, '<em>$1</em>')
                .replace(/`([^`]+)`/gim, '<code class="bg-indigo-100/70 text-indigo-900 px-1 py-0.5 rounded text-[11px] font-mono">$1</code>')
                .replace(/^\s*\n\*/gm, '<ul>\n*')
                .replace(/^(\*|\-)\s+(.*)/gim, '<li>$2</li>')
                .replace(/\n\n/gim, '<p></p>')
                .replace(/\n/gim, '<br>');
            return html;
